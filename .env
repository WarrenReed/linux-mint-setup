# Bootstrap Configuration
# This file contains customizable settings for the bootstrap script.
# You can modify these values to suit your environment.

# APT Keyring Directory
# Old convention (compatible with Linux Mint UI): /etc/apt/trusted.gpg.d
# Modern convention: /usr/share/keyrings
export KEYRING_DIR="/etc/apt/trusted.gpg.d"

# Ubuntu Distribution Codename
# Linux Mint 22 is based on Ubuntu 24.04 LTS (noble)
# Options: noble=24.04, jammy=22.04, focal=20.04
export UBUNTU_DISTRO="noble"

# oh-my-posh Theme Path
# Used for Bash, Fish, and PowerShell shell configuration
export OMP_THEME_PATH="~/.cache/oh-my-posh/themes/atomic.omp.json"

# Private Internet Access VPN Fallback Version
# Used if automatic version detection fails
export PIA_FALLBACK_VERSION="3.7-08412"
