# Preseed Configuration
# This file contains customizable settings for the preseed template.
# You can modify these values to suit your environment.
#
# For personal overrides without modifying this tracked file,
# create ventoy/preseed.env.local (gitignored).

# Locale
# Examples: en_US.UTF-8, en_GB.UTF-8, en_ZA.UTF-8
export PRESEED_LOCALE="en_US.UTF-8"

# Keyboard Layout
# Examples: us, gb, de, fr
export PRESEED_KEYBOARD_LAYOUT="us"

# Timezone
# Examples: UTC, America/New_York, Europe/London, Africa/Johannesburg
export PRESEED_TIMEZONE="UTC"

# User Full Name
export PRESEED_FULLNAME="Your Name"

# Username (login name, lowercase, no spaces)
export PRESEED_USERNAME="username"

# Hostname
export PRESEED_HOSTNAME="linux-mint"
